//| mill-version: 1.0.6-jvm

import mill._
import mill.scalalib._

object app extends ScalaModule {
  def scalaVersion = "2.13.18"
  def mainClass = Task { Some("Main") }

  // Official Chisel from Maven Central: PR #5276 (circt_debug_* intrinsics)
  // shipped in 7.13.0, so the demos no longer need the fkhaidari/chisel
  // JitPack fork (and with it the scopt transitive workaround that JitPack
  // resolution forced).
  def mvnDeps = Seq(
    mvn"org.chipsalliance::chisel:7.13.0",
    mvn"org.chipsalliance:::chisel-plugin:7.13.0",
  )

  def scalacOptions = Task {
    val plugin = compileClasspath()
      .find(_.path.toString.contains("chisel-plugin"))
      .map(p => s"-Xplugin:${p.path}")
    Seq("-Ymacro-annotations") ++ plugin
  }
}
