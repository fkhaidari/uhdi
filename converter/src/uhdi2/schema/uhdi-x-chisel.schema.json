{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://circt.llvm.org/uhdi/x-chisel.schema.json",
  "title": "UHDI x-chisel extension",
  "description": "Validates the `x-chisel` keys of a document that lists `x-chisel` in `profiles`. Apply it together with the core schema, which accepts `x-` keys without looking inside. The class name itself is the core `name`; `x-chisel` adds only the constructor parameters.",
  "type": "object",
  "properties": {
    "types": {
      "type": "array",
      "items": {
        "properties": {
          "x-chisel": {
            "$ref": "#/$defs/chisel"
          }
        }
      }
    },
    "original": {
      "type": "object",
      "additionalProperties": {
        "properties": {
          "x-chisel": {
            "$ref": "#/$defs/chisel"
          },
          "vars": {
            "type": "object",
            "additionalProperties": {
              "not": {
                "required": [
                  "x-chisel"
                ]
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "chisel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "params": {
          "$ref": "#/$defs/params"
        }
      }
    },
    "params": {
      "description": "Constructor parameters of a Chisel class.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "typeName": {
            "description": "Scala type of the parameter.",
            "type": "string"
          },
          "value": {
            "description": "Value as Chisel sent it, when it sent one."
          }
        }
      }
    }
  }
}
