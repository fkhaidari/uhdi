{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uhdi/uhdi-1.0.schema.json",
  "$defs": {
    "Ref": {
      "description": "Opaque reference (typeRef / moduleRef): a key into `types` or `modules`, with no structure a consumer may rely on.",
      "type": "string"
    },
    "Format": {
      "type": "object",
      "required": ["version"],
      "additionalProperties": false,
      "patternProperties": {"^x-": true},
      "properties": {
        "version": {"const": "1.0"}
      }
    },
    "LanguageFiles": {
      "type": "object",
      "required": ["language", "files"],
      "additionalProperties": false,
      "patternProperties": {"^x-": true},
      "properties": {
        "language": {"type": "string"},
        "files": {"type": "array", "items": {"type": "string"}}
      }
    },
    "Direction": {"enum": ["input", "output", "inout"]},
    "ScopeKind": {"enum": ["module", "extmodule", "inline"]},
    "Location": {
      "description": "`file` indexes the files list of the side the location belongs to: `source.files` for a `source.loc`, `target.files` for a `target.loc` or for the `loc` of a scalar binding.",
      "type": "object",
      "required": ["file"],
      "additionalProperties": false,
      "patternProperties": {"^x-": true},
      "properties": {
        "file": {"type": "integer", "minimum": 0},
        "beginLine": {"type": "integer", "minimum": 1},
        "beginColumn": {"type": "integer", "minimum": 1},
        "endLine": {"type": "integer", "minimum": 1},
        "endColumn": {"type": "integer", "minimum": 1}
      }
    },
    "ModuleSource": {
      "description": "The module or scope as the frontend wrote it.",
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {"^x-": true},
      "properties": {
        "name": {"type": "string"},
        "typeName": {"type": "string"},
        "params": {"type": "array", "items": {"$ref": "#/$defs/TypeSourceParam"}},
        "loc": {"$ref": "#/$defs/Location"}
      }
    },
    "ModuleTarget": {
      "description": "The module or scope after lowering. `name` is omitted on a top-level `modules` entry, whose key is its target name; an inline scope under `scopes` has no key and may carry one.",
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {"^x-": true},
      "properties": {
        "name": {"type": "string"},
        "loc": {"$ref": "#/$defs/Location"}
      }
    },
    "VariableSource": {
      "description": "The variable as the frontend wrote it. `name` is omitted when it equals the record's key, which is the usual case; it is present only when two declarations in one scope wanted the same name and the emitter keyed one of them by something else. `binding` is the declaration kind (IO, Wire, Reg). The source type name is on the type entry, `types[typeRef].source.name`, so `binding[types[typeRef].source.name]` spells what the frontend wrote and the name is stored once per type. `params` holds constructor parameters of the variable itself when the type entry does not already carry them.",
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {"^x-": true},
      "properties": {
        "name": {"type": "string"},
        "binding": {"type": "string"},
        "params": {"type": "array", "items": {"$ref": "#/$defs/TypeSourceParam"}},
        "loc": {"$ref": "#/$defs/Location"}
      }
    },
    "ScalarBinding": {
      "description": "A leaf's value after lowering: a signal name, `{signal, loc}` when the leaf also has a target-side location, or a literal as `{constant}` or `{bitVector}`.",
      "anyOf": [
        {"type": "string"},
        {
          "type": "object",
          "required": ["signal"],
          "additionalProperties": false,
          "properties": {
            "signal": {"type": "string"},
            "loc": {"$ref": "#/$defs/Location"}
          }
        },
        {
          "type": "object",
          "required": ["constant"],
          "additionalProperties": false,
          "properties": {"constant": {}}
        },
        {
          "type": "object",
          "required": ["bitVector"],
          "additionalProperties": false,
          "properties": {"bitVector": {"type": "string"}}
        }
      ]
    },
    "Binding": {
      "description": "A scalar variable binds to one ScalarBinding. An aggregate binds through an object mapping a dotted member path (struct members and vector indices joined with '.') to a ScalarBinding, one entry per leaf that has a value; a path missing from the map is a leaf with no signal. Open beyond that: a consumer must not assume more structure.",
      "anyOf": [
        {"$ref": "#/$defs/ScalarBinding"},
        {"type": "object"}
      ]
    },
    "VariableTarget": {
      "type": "object",
      "required": ["verilog"],
      "additionalProperties": false,
      "patternProperties": {"^x-": true},
      "properties": {
        "verilog": {"$ref": "#/$defs/Binding"},
        "loc": {
          "description": "An aggregate variable's own verilog-side location, when it has one (a ScalarBinding embeds its own `loc` instead; this sibling is unused when `verilog` is a ScalarBinding).",
          "$ref": "#/$defs/Location"
        }
      }
    },
    "Variable": {
      "description": "A variable is a port iff it has a `direction`.",
      "type": "object",
      "required": ["typeRef", "source"],
      "additionalProperties": false,
      "patternProperties": {"^x-": true},
      "properties": {
        "typeRef": {"$ref": "#/$defs/Ref"},
        "direction": {"$ref": "#/$defs/Direction"},
        "source": {"$ref": "#/$defs/VariableSource"},
        "target": {"$ref": "#/$defs/VariableTarget"}
      }
    },
    "InstanceSource": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {"^x-": true},
      "properties": {
        "loc": {"$ref": "#/$defs/Location"}
      }
    },
    "InstanceTarget": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {"^x-": true},
      "properties": {
        "verilog": {
          "description": "portPath -> Binding, one entry per bound instance port.",
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/Binding"}
        },
        "loc": {"$ref": "#/$defs/Location"}
      }
    },
    "Instance": {
      "type": "object",
      "required": ["moduleRef"],
      "additionalProperties": false,
      "patternProperties": {"^x-": true},
      "properties": {
        "moduleRef": {"$ref": "#/$defs/Ref"},
        "source": {"$ref": "#/$defs/InstanceSource"},
        "target": {"$ref": "#/$defs/InstanceTarget"}
      }
    },
    "Module": {
      "description": "A module/extmodule (top-level `modules` entry) or an inline scope (nested under a parent's `scopes`).",
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {"^x-": true},
      "properties": {
        "kind": {"$ref": "#/$defs/ScopeKind"},
        "source": {"$ref": "#/$defs/ModuleSource"},
        "target": {"$ref": "#/$defs/ModuleTarget"},
        "variables": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/Variable"}
        },
        "instances": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/Instance"}
        },
        "scopes": {
          "type": "array",
          "items": {"$ref": "#/$defs/Module"}
        }
      }
    },
    "TypeRef": {
      "description": "Key into `types`. Opaque, with no structure a consumer may rely on.",
      "type": "string"
    },
    "TypeSourceParam": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "patternProperties": {"^x-": true},
      "properties": {
        "name": {"type": "string"},
        "type": {"type": "string"},
        "value": {}
      }
    },
    "TypeSource": {
      "description": "The type's name as the frontend spelled it (`UInt<8>`, `Operands`, `Clock`) and its constructor parameters. Types are interned by structure and source name together, so two frontend types that lower to the same structure stay two entries.",
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {"^x-": true},
      "properties": {
        "name": {"type": "string"},
        "params": {"type": "array", "items": {"$ref": "#/$defs/TypeSourceParam"}}
      }
    },
    "GroundInt": {
      "type": "object",
      "required": ["kind", "width"],
      "additionalProperties": false,
      "patternProperties": {"^x-": true},
      "properties": {
        "kind": {"enum": ["uint", "sint"]},
        "width": {"type": "integer", "minimum": 0},
        "source": {"$ref": "#/$defs/TypeSource"}
      }
    },
    "GroundClock": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "patternProperties": {"^x-": true},
      "properties": {
        "kind": {"enum": ["clock", "reset", "asyncreset", "analog"]},
        "width": {"type": "integer", "minimum": 0},
        "source": {"$ref": "#/$defs/TypeSource"}
      }
    },
    "StructMember": {
      "type": "object",
      "required": ["name", "typeRef"],
      "additionalProperties": false,
      "patternProperties": {"^x-": true},
      "properties": {
        "name": {"type": "string"},
        "typeRef": {"$ref": "#/$defs/TypeRef"},
        "flipped": {"type": "boolean", "default": false}
      }
    },
    "Struct": {
      "type": "object",
      "required": ["kind", "members"],
      "additionalProperties": false,
      "patternProperties": {"^x-": true},
      "properties": {
        "kind": {"const": "struct"},
        "members": {"type": "array", "items": {"$ref": "#/$defs/StructMember"}},
        "source": {"$ref": "#/$defs/TypeSource"}
      }
    },
    "Vector": {
      "type": "object",
      "required": ["kind", "elementRef", "size"],
      "additionalProperties": false,
      "patternProperties": {"^x-": true},
      "properties": {
        "kind": {"const": "vector"},
        "elementRef": {"$ref": "#/$defs/TypeRef"},
        "size": {"type": "integer", "minimum": 0},
        "source": {"$ref": "#/$defs/TypeSource"}
      }
    },
    "Enum": {
      "type": "object",
      "required": ["kind", "underlyingTypeRef", "variants"],
      "additionalProperties": false,
      "patternProperties": {"^x-": true},
      "properties": {
        "kind": {"const": "enum"},
        "underlyingTypeRef": {"$ref": "#/$defs/TypeRef"},
        "variants": {
          "type": "object",
          "patternProperties": {"^-?[0-9]+$": {"type": "string"}},
          "additionalProperties": false
        },
        "source": {"$ref": "#/$defs/TypeSource"}
      }
    },
    "Type": {
      "description": "Tag-discriminated union over the type kinds. Dispatch on `kind` first via if/then/else so a typo produces one focused error instead of an all-branches-tried report.",
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": ["uint", "sint", "clock", "reset", "asyncreset",
                   "analog", "struct", "vector", "enum"]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"enum": ["uint", "sint"]}}},
          "then": {"$ref": "#/$defs/GroundInt"}
        },
        {
          "if": {
            "properties": {
              "kind": {"enum": ["clock", "reset", "asyncreset", "analog"]}
            }
          },
          "then": {"$ref": "#/$defs/GroundClock"}
        },
        {
          "if": {"properties": {"kind": {"const": "struct"}}},
          "then": {"$ref": "#/$defs/Struct"}
        },
        {
          "if": {"properties": {"kind": {"const": "vector"}}},
          "then": {"$ref": "#/$defs/Vector"}
        },
        {
          "if": {"properties": {"kind": {"const": "enum"}}},
          "then": {"$ref": "#/$defs/Enum"}
        }
      ]
    }
  },
  "type": "object",
  "required": ["format", "source", "target", "types", "modules"],
  "additionalProperties": false,
  "patternProperties": {"^x-": true},
  "properties": {
    "format": {"$ref": "#/$defs/Format"},
    "source": {"$ref": "#/$defs/LanguageFiles"},
    "target": {"$ref": "#/$defs/LanguageFiles"},
    "types": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/Type"}
    },
    "modules": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/Module"}
    }
  }
}
