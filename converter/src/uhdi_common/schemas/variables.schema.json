{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uhdi/variables.schema.json",
  "$defs": {
    "VarRef": {
      "description": "Key into the variables pool. Opaque: unique within the pool, no structure a consumer may rely on.",
      "type": "string"
    },
    "TypeRef": {
      "description": "Key into the types pool. Opaque: unique within the pool, no structure a consumer may rely on.",
      "type": "string"
    },
    "ExprRef": {
      "description": "Key into the expressions pool. Opaque: unique within the pool, no structure a consumer may rely on.",
      "type": "string"
    },
    "ScopeRef": {
      "description": "Key into the scopes pool. Opaque: unique within the pool, no structure a consumer may rely on.",
      "type": "string"
    },
    "Location": {
      "type": "object",
      "required": [
        "file"
      ],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "integer",
          "minimum": 0
        },
        "beginLine": {
          "type": "integer",
          "minimum": 1
        },
        "endLine": {
          "type": "integer",
          "minimum": 1
        },
        "beginColumn": {
          "type": "integer",
          "minimum": 1
        },
        "endColumn": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "BindKind": {
      "enum": [
        "port",
        "wire",
        "reg",
        "node",
        "literal",
        "mem",
        "synthetic",
        "instance",
        "probe",
        "rwprobe"
      ]
    },
    "Direction": {
      "enum": [
        "input",
        "output",
        "inout"
      ]
    },
    "Status": {
      "enum": [
        "preserved",
        "reconstructed",
        "lost"
      ]
    },
    "ValueBinding": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "sigName"
          ],
          "additionalProperties": false,
          "properties": {
            "sigName": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "exprRef"
          ],
          "additionalProperties": false,
          "properties": {
            "exprRef": {
              "$ref": "#/$defs/ExprRef"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "constant"
          ],
          "additionalProperties": false,
          "properties": {
            "constant": {
              "type": "integer"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "bitVector"
          ],
          "additionalProperties": false,
          "properties": {
            "bitVector": {
              "type": "string",
              "pattern": "^[01xzXZ?]+$"
            }
          }
        }
      ]
    },
    "SourceLangType": {
      "description": "Surface-language type info (e.g. Chisel `Wire[UInt<8>]` or `IO[Bundle]`) for waveform / GUI consumers that render authoring-language types alongside the bound HDL signal. `typeName` is the rendered string. `params` is an opaque escape hatch reserved for parameterized-type metadata; emitters may attach an arbitrary JSON value, but no consumer reads it today.",
      "type": "object",
      "required": ["typeName"],
      "additionalProperties": false,
      "properties": {
        "typeName": { "type": "string" },
        "params": {}
      }
    },
    "PerRepresentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/Location"
        },
        "value": {
          "$ref": "#/$defs/ValueBinding"
        },
        "status": {
          "$ref": "#/$defs/Status"
        },
        "sourceLangType": {
          "$ref": "#/$defs/SourceLangType"
        }
      }
    },
    "Variable": {
      "type": "object",
      "required": [
        "typeRef",
        "bindKind"
      ],
      "additionalProperties": false,
      "properties": {
        "typeRef": {
          "$ref": "#/$defs/TypeRef"
        },
        "ownerScopeRef": {
          "$ref": "#/$defs/ScopeRef"
        },
        "bindKind": {
          "$ref": "#/$defs/BindKind"
        },
        "direction": {
          "$ref": "#/$defs/Direction"
        },
        "representations": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/PerRepresentation"
          }
        },
        "delay": {
          "type": "integer",
          "minimum": 0
        },
        "memberRefs": {
          "description": "Ordered member variables of a dissolved aggregate (struct member order / array index order). Present instead of a simulation `value` binding.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/VarRef"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "bindKind": { "const": "port" } },
            "required": ["bindKind"]
          },
          "then": { "required": ["direction"] },
          "else": { "not": { "required": ["direction"] } }
        }
      ]
    }
  },
  "type": "object",
  "additionalProperties": {
    "$ref": "#/$defs/Variable"
  }
}