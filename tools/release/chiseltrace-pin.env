# Chiseltrace fork pin -- used by tools/release/release-chiseltrace.nu only.
#
# Kept out of tools/versions.env (and therefore out of the uhdi-tools
# Docker image-tag hash) because chiseltrace is shipped via a separate
# GitHub release tarball, not baked into the bench image. Bumping these
# pins must not rebuild CIRCT, so they live here.
#
# Shell-sourceable: KEY=VALUE per line, no quotes, no `export`.

# Mirror of github.com/jarlb/chiseltrace so the pinned SHA stays
# reachable; the release-chiseltrace.nu script ships both
# `chiseltrace-cli` (slice / DynPDG / convert-to-source) and
# `chiseltrace` (GUI) in one tarball.
CHISELTRACE_URL=https://github.com/fkhaidari/chiseltrace.git
CHISELTRACE_REV=f4bf63ab036181ca9a37d1f4b2779569ab09b5a2
